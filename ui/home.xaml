<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="44,10,44,40">
    <DockPanel>
      <Button x:Name="BtnRescan" DockPanel.Dock="Right" Style="{StaticResource Ghost}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource NavIcon}" Width="14" Height="14"
                Data="M21,12 A9,9 0 1 1 18.4,5.6 M21,3 V8 H16"/>
          <TextBlock Text="{DynamicResource L_Rescan}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Text="{DynamicResource L_MyDevices}" Style="{StaticResource H1}" FontSize="26"/>
        <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                   Text="{DynamicResource L_HomeSub}"/>
      </StackPanel>
    </DockPanel>
    <WrapPanel x:Name="Cards" Margin="0,30,0,0"/>
    <TextBlock x:Name="HomeNote" Style="{StaticResource Hint}" Margin="2,2,0,0" TextWrapping="Wrap"/>
  </StackPanel>
</ScrollViewer>
