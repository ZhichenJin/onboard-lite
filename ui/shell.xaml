<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Bg}" TextOptions.TextFormattingMode="Display">
  <Grid.RowDefinitions>
    <RowDefinition Height="56"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <DockPanel Grid.Row="0" LastChildFill="False">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
      <Button x:Name="BtnLang" Style="{StaticResource LangBtn}" Margin="0,13,6,0">
        <Grid Width="76" Height="30">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border x:Name="LangThumb" CornerRadius="8" Margin="3" Background="{DynamicResource Surface}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Border.RenderTransform>
              <TranslateTransform x:Name="LangShift"/>
            </Border.RenderTransform>
          </Border>
          <TextBlock x:Name="LangZh" Text="文" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock x:Name="LangEn" Grid.Column="1" Text="ENG" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <Button x:Name="BtnTheme" Style="{StaticResource IconBtn}" Margin="0,10,8,0">
        <Path x:Name="ThemeIcon" Style="{StaticResource NavIcon}" Width="17" Height="17" RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
            <RotateTransform x:Name="ThemeSpin"/>
          </Path.RenderTransform>
        </Path>
      </Button>
      <Button x:Name="BtnMin" Style="{StaticResource TitleBtn}" ToolTip="{DynamicResource L_Min}">
        <Path Data="M0,0 L10,0" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button x:Name="BtnMax" Style="{StaticResource TitleBtn}" ToolTip="{DynamicResource L_Max}">
        <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" ToolTip="{DynamicResource L_Close}">
        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
    </StackPanel>

    <Grid VerticalAlignment="Center" Margin="20,0,0,0">
      <StackPanel x:Name="Brand" Orientation="Horizontal">
        <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Accent}">
          <Grid>
            <Border Width="10" Height="15" CornerRadius="5" BorderThickness="1.6" BorderBrush="White"/>
            <Border Width="1.6" Height="4" Background="White" VerticalAlignment="Top" Margin="0,8,0,0"/>
          </Grid>
        </Border>
        <TextBlock Text="Onboard Lite" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource Text}"/>
      </StackPanel>
      <Button x:Name="BtnBack" Style="{StaticResource BackBtn}" Visibility="Collapsed" Margin="-6,0,0,0">
        <StackPanel Orientation="Horizontal">
          <Path Data="M6,0 L0,6 L6,12" Width="7" Height="12" Stretch="Uniform" StrokeThickness="1.8"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
          <TextBlock Text="{DynamicResource L_MyDevices}" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>
  </DockPanel>

  <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

  <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
          Padding="18,11" CornerRadius="12" Background="{DynamicResource Popup}" BorderBrush="{DynamicResource Line}"
          BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
    <TextBlock x:Name="ToastText" Foreground="{DynamicResource Text}" FontSize="13.5"/>
  </Border>
</Grid>
